# Copy to .env to override. Every value has a working default in docker-compose.yml.

# dev (watch mode, source mounted) or prod (compiled images)
BUILD_TARGET=dev

# Origins the backend accepts CORS requests from, comma-separated
CORS_ORIGINS=http://localhost:3000

# URL the browser uses to reach the backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
